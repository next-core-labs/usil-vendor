// vendor.usil.app on Cloudflare Workers: the static console plus a proxy to usil-backend.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usil-vendor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "services": [{ "binding": "BACKEND", "service": "usil-backend" }],
  "routes": [{ "pattern": "vendor.usil.app", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
